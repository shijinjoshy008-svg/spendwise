
#call for creating
###
POST http://127.0.0.1:8000/v1/spending/register/
Content-Type: application/json

{
    "username":"user",
    "email":"user@gmail.com",
    "password":"password@123"
}

#api call for token generation
###
POST http://127.0.0.1:8000/v1/spending/token/
Content-Type: application/json

{
    "username":"django",
    "password":"password@123"
}

#call for get current user detail
###
GET http://127.0.0.1:8000/v1/spending/me/
Accept: application/json
Authorization: Token b5e6ab1b2cc1619da59b460447cf3e5cfc72fcae
#Authorization: Basic django1:password@123


#expense endpoints
#for listing all
###
GET http://127.0.0.1:8000/v1/spending/expense/
Accept: application/json
Authorization: Token 7bc7b416e9d5fe4e9dd08d29d78e0834a605f17e
#Authorization: Basic django1:password@123
 

#for adding
###
POST http://127.0.0.1:8000/v1/spending/expense/
Content-Type: application/json
Authorization: Token 7bc7b416e9d5fe4e9dd08d29d78e0834a605f17e
#Authorization: Basic django1:password@123

{
    "title":"movie",
    "amount":1000,
    "category":"ENTERTAINMENT",
    "payment_method":"upi"


}

#for retrieving
###
GET http://127.0.0.1:8000/v1/spending/expense/4/
Accept: application/json
Authorization: Token b5e6ab1b2cc1619da59b460447cf3e5cfc72fcae
#Authorization: Basic user:password@123


#for updating
###
PUT http://127.0.0.1:8000/v1/spending/expense/4/
Content-Type: application/json
Authorization: Token b5e6ab1b2cc1619da59b460447cf3e5cfc72fcae


{
  "id": 4,
  "title": "medicine",
  "amount": "4000.00",
  "category": "FOOD",
  "priority": "need",
  "payment_method": "cash",
  "created_at": "2026-10-12T13:31:05.965061Z",
  "updated_at": "2026-10-12T13:31:05.965129Z",
  "owner": 3
}


#for deleting
###
DELETE http://127.0.0.1:8000/v1/spending/expense/3/
Accept: application/json
Authorization: Basic django:password@123

#api call for getting total
###
GET http://127.0.0.1:8000/v1/spending/expense/summary/
Accept: application/json
Authorization: Token 7bc7b416e9d5fe4e9dd08d29d78e0834a605f17e

