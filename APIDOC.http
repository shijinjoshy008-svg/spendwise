
#call for creating
###
POST http://127.0.0.1:8000/v1/spending/register/
Content-Type: application/json

{
    "username":"django2",
    "email":"django@gmail.com",
    "password":"password@123"
}

#api cal for getting token
###
POST http://127.0.0.1:8000/v1/spending/token/
Content-Type: application/json

{
    "username":"django2",
    "password":"password@123"
    
}



#call for get current user detail
###
GET http://127.0.0.1:8000/v1/spending/me/
Accept: application/json
Authorization: token 13c64471b4cdca7573b3f37e6b5501c775cc4b5b

#expense endpoints
#for listing all
###
GET http://127.0.0.1:8000/v1/spending/expense/
Accept: application/json
Authorization: token 13c64471b4cdca7573b3f37e6b5501c775cc4b5b

#for adding
###
POST http://127.0.0.1:8000/v1/spending/expense/
Content-Type: application/json
Authorization: token 13c64471b4cdca7573b3f37e6b5501c775cc4b5b

{
    "title":"medicine",
    "amount":4000,
    "category":"FOOD",
    "payment_method":"upi"


}

#for retrieving
###
GET http://127.0.0.1:8000/v1/spending/expense/2/
Accept: application/json
Authorization: token 13c64471b4cdca7573b3f37e6b5501c775cc4b5b

#for updating
###
PUT http://127.0.0.1:8000/v1/spending/expense/2/
